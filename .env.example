# Copy to `.env` for local NTT CLI / SDK usage. Never commit secrets.

# EVM deployer key used by `ntt add-chain` (Mezo + Base / BaseSepolia).
ETH_PRIVATE_KEY=

# Optional scanner keys for contract verification during add-chain.
ETHERSCAN_API_KEY=
BASESCAN_API_KEY=

# Optional RPC overrides (prefer overrides.json from example-overrides.json).
MEZO_TESTNET_RPC_URL=https://rpc.test.mezo.org
MEZO_MAINNET_RPC_URL=
BASE_SEPOLIA_RPC_URL=
BASE_RPC_URL=
